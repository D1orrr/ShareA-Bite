# ShareA'Bite Backend Environment Variables (copy to .env — all optional)
DATABASE_URL=sqlite:///./share_a_bite.db

# Change this for anything beyond a local demo
SECRET_KEY=sharea-bite-dev-secret-change-me

# Google Gemini API Key (free key: https://aistudio.google.com/)
# Leave empty to use the built-in rule-based recipe generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
