{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(recipe|cook|finish)/([0-9]+)/?", "dest": "/frontend/$1/$2.html" },
    { "src": "/(.*\\.[a-zA-Z0-9]+)", "dest": "/frontend/$1" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.+?)/?", "dest": "/frontend/$1.html" }
  ]
}
